:root {
    --col-cyan: rgb(88, 224, 232);
    --col-cyan-dim: rgba(88, 224, 232, 0.5);
    --col-gold: rgb(214, 178, 96);
    --col-text: rgb(230, 235, 240);
    --col-text-dim: rgb(160, 170, 180);
    --col-panel-bg: rgba(10, 16, 24, 0.9);
    --col-panel-border: rgba(120, 200, 220, 0.25);
    --col-error: rgb(224, 96, 96);
}

.pw-root {
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

/* ---------- Main panel ---------- */
.pw-panel {
    background-color: var(--col-panel-bg);
    border-width: 2px;
    border-color: var(--col-cyan-dim);
    border-radius: 14px;
    padding: 48px 56px;
    align-items: center;
    min-width: 720px;
}

.pw-title {
    color: var(--col-gold);
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.pw-hint {
    color: var(--col-text-dim);
    font-size: 17px;
    -unity-font-style: italic;
    margin-bottom: 36px;
}

/* ---------- Slot row ---------- */
.slots-panel {
    margin-bottom: 36px;
}

/* Built at runtime, one per password digit */
.pw-item {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 150px;
    margin-left: 18px;
    margin-right: 18px;
}

.pw-arrow-btn {
    width: 76px;
    height: 46px;
    margin: 10px 0;
    background-color: rgba(88, 224, 232, 0.08);
    border-width: 2px;
    border-color: var(--col-cyan-dim);
    border-radius: 6px;
    color: var(--col-cyan);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}

.pw-arrow-btn:hover {
    background-color: rgba(88, 224, 232, 0.18);
    border-color: var(--col-cyan);
}

.pw-arrow-btn:active {
    background-color: rgba(88, 224, 232, 0.30);
}

.pw-icon-frame {
    width: 130px;
    height: 130px;
    border-width: 3px;
    border-color: var(--col-gold);
    border-radius: 12px;
    background-color: rgba(214, 178, 96, 0.08);
    -unity-background-scale-mode: scale-to-fit;
    margin: 6px 0;
}

.pw-slot-label {
    color: var(--col-text-dim);
    font-size: 16px;
    margin-top: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Footer ---------- */
.pw-footer {
    align-items: center;
}

.pw-status {
    font-size: 18px;
    color: var(--col-error);
    margin-bottom: 16px;
    -unity-font-style: bold;
    display: none;
}

.pw-submit-button {
    width: 260px;
    height: 54px;
    background-color: rgba(214, 178, 96, 0.15);
    border-width: 2px;
    border-color: var(--col-gold);
    border-radius: 8px;
    color: var(--col-gold);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.pw-submit-button:hover {
    background-color: rgba(214, 178, 96, 0.28);
}

.pw-submit-button:active {
    background-color: rgba(214, 178, 96, 0.4);
}
